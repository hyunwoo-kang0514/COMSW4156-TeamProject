# AI-generated (Claude Code), reviewed by Ziyue Fang. See README "AI Documentation" section.
#
# StudyMate first-iteration demo, for the VS Code REST Client extension
# (humao.rest-client). Click "Send Request" above each request, top to bottom.
#
# Setup: start the local H2 server from README Section 5 (port 8081). It loads
# src/test/resources/local-seed.sql, which provides:
#   student 1  hk3382 (Harry), key test-key-1, already has a preference
#   group 2    "Full COMS4156 Group", 2/2 members
# Restart the server to reset the data before each run.
#
# Story: a new student, Alex, registers and sets a preference. Harry creates
# a group. Alex finds it, joins it, and leaves it.
#
# To let the Mentor drive through a tunnel, change @baseUrl to the tunnel URL
# (for example https://<name>.trycloudflare.com/api).

@baseUrl = http://localhost:8081/api
@harryKey = test-key-1

### 0. Health check: the service is up
GET {{baseUrl}}/health


######################################################################
# Register Student (Kevin)
######################################################################

### 1a. Register Alex -> 201 with a new id and API key
# @name register
POST {{baseUrl}}/students
Content-Type: application/json

{
  "studentId": "ab1234",
  "name": "Alex Lee",
  "email": "alex@example.com",
  "school": "Columbia",
  "major": "Computer Science",
  "year": 3
}

### 1b. Register the same studentId again -> 409, nothing created
POST {{baseUrl}}/students
Content-Type: application/json

{
  "studentId": "ab1234",
  "name": "Alex Again",
  "email": "alex2@example.com",
  "school": "Columbia",
  "major": "Computer Science",
  "year": 3
}

### 1c. Register with missing fields -> 400
POST {{baseUrl}}/students
Content-Type: application/json

{
  "studentId": "cd5678"
}


# Alex's database id and key, taken from the response to 1a
@alexId = {{register.response.body.$.id}}
@alexKey = {{register.response.body.$.apiKey}}


######################################################################
# Study Preference (Ugorji)
######################################################################

### 2a. Register Alex's preference -> 201
POST {{baseUrl}}/
X-API-KEY: {{alexKey}}
Content-Type: application/json

{
  "id": {{alexId}},
  "course": "COMS4156",
  "meetingMode": "IN_PERSON",
  "preferredGroupSize": 4,
  "studyStyles": ["collaborative"],
  "availableTimes": [
    { "day": "MONDAY", "startTime": "13:00", "endTime": "16:00" }
  ]
}

### 2b. Read it back -> 200
GET {{baseUrl}}/{{alexId}}
X-API-KEY: {{alexKey}}

### 2c. Update it: add a study style and a Wednesday slot -> 200, lists replaced
PUT {{baseUrl}}/{{alexId}}
X-API-KEY: {{alexKey}}
Content-Type: application/json

{
  "course": "COMS4156",
  "meetingMode": "IN_PERSON",
  "preferredGroupSize": 4,
  "studyStyles": ["collaborative", "focused"],
  "availableTimes": [
    { "day": "MONDAY", "startTime": "13:00", "endTime": "16:00" },
    { "day": "WEDNESDAY", "startTime": "18:00", "endTime": "20:00" }
  ]
}

### 2d. Preference for a student that does not exist -> 404
GET {{baseUrl}}/999
X-API-KEY: {{alexKey}}

### 2e. Bogus API key -> 401
GET {{baseUrl}}/{{alexId}}
X-API-KEY: bogus


######################################################################
# Create Study Group (Hyunwoo Kim)
######################################################################

# Create-group demo adapted with OpenAI Codex.
# Uses the same seeded H2 server and Harry's key as the rest of this demo.
# Corrected validation examples use course VALIDATION-DEMO so the extra groups
# do not affect Alex's COMS4156 matching demonstration later in this file.

### 3a. Successful creation -> 200, Harry is the first member
# Tests: saves a group, copies the creator's school, sets numMembers=1 and recruiting=true.
# Verify the response: generated groupId, school="Columbia", memberIds=["hk3382"],
# numMembers=1 and recruiting=true. Requests 4a/4b reuse this saved group.
# Implementation: StudyGroupService.createStudyGroup() -> StudyGroupRepository.save().
# @name createGroup
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "creatorStudentId": 1,
  "name": "COMS4156 Monday Crew",
  "course": "COMS4156",
  "maxMembers": 4,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}

### 3b. Student lookup: nonexistent creator -> 404 Not Found
# Tests: a valid API key does not allow creating a group for a nonexistent student.
# Student 999999999 does not exist in the fresh H2 demo data.
# Expected error: {"error":"Student not found for ID 999999999"}
# Implementation: StudentService.findStudentById() queries StudentRepository;
# StudyGroupService throws NoSuchElementException; ApiController maps it to 404.
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "creatorStudentId": 999999999,
  "name": "Lookup validation group",
  "course": "VALIDATION-DEMO",
  "maxMembers": 4,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}

### 3b-correct. Student lookup corrected: existing creator -> 200
# Fix: change creatorStudentId from 999999999 to seeded student 1.
# Expected: saved group, numMembers=1, recruiting=true, and a generated groupId.
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "creatorStudentId": 1,
  "name": "Lookup validation group",
  "course": "VALIDATION-DEMO",
  "maxMembers": 4,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}

### 3c. Minimum group size: capacity of one -> 400 Bad Request
# Tests: capacity must be at least two, including the creator. Other input remains valid.
# Expected error: {"error":"maxMembers must be at least 2."}
# Implementation: StudyGroupService.createStudyGroup() checks maxMembers < 2;
# ApiController maps IllegalArgumentException to 400.
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "creatorStudentId": 1,
  "name": "Capacity validation group",
  "course": "VALIDATION-DEMO",
  "maxMembers": 1,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}

### 3c-correct. Minimum group size corrected: capacity of two -> 200
# Fix: change maxMembers from 1 to 2, the smallest permitted capacity.
# Expected: saved group, numMembers=1, recruiting=true, and a generated groupId.
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "creatorStudentId": 1,
  "name": "Capacity validation group",
  "course": "VALIDATION-DEMO",
  "maxMembers": 2,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}

### 3d. Server-controlled field: caller supplies groupId -> 400 Bad Request
# Tests: the caller cannot choose the database-generated group ID.
# Expected: Spring error response; this is rejected during JSON conversion,
# before ApiController.createStudyGroup() runs, so its custom error body is not used.
# Implementation: CreateStudyGroupRequest.rejectUnknownField(), via @JsonAnySetter.
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "groupId": 999,
  "creatorStudentId": 1,
  "name": "Field validation group",
  "course": "VALIDATION-DEMO",
  "maxMembers": 4,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}

### 3d-correct. Server-controlled field corrected: omit groupId -> 200
# Fix: remove groupId; the database generates the ID returned in the response.
# Expected: saved group, numMembers=1, recruiting=true, and a generated groupId.
POST {{baseUrl}}/groups
X-API-KEY: {{harryKey}}
Content-Type: application/json

{
  "creatorStudentId": 1,
  "name": "Field validation group",
  "course": "VALIDATION-DEMO",
  "maxMembers": 4,
  "schedules": [
    {
      "day": "MONDAY",
      "startTime": "14:00",
      "endTime": "16:00"
    }
  ],
  "studyStyles": [
    "collaborative",
    "focused"
  ],
  "meetingMode": "IN_PERSON"
}


@groupId = {{createGroup.response.body.$.groupId}}


######################################################################
# Find and Join (Hyunwoo Kang)
######################################################################

### 4a. Find groups for Alex -> 200, Harry's group ranked first
GET {{baseUrl}}/find?studentId={{alexId}}
X-API-KEY: {{alexKey}}

### 4b. Alex joins Harry's group -> 200, numMembers 1 -> 2
POST {{baseUrl}}/join
X-API-KEY: {{alexKey}}
Content-Type: application/json

{ "studentId": {{alexId}}, "groupId": {{groupId}} }

### 4c. Same join again (client retry) -> 200, Alex is not added twice
POST {{baseUrl}}/join
X-API-KEY: {{alexKey}}
Content-Type: application/json

{ "studentId": {{alexId}}, "groupId": {{groupId}} }

### 4d. Join the full seeded group 2 -> 400
POST {{baseUrl}}/join
X-API-KEY: {{alexKey}}
Content-Type: application/json

{ "studentId": {{alexId}}, "groupId": 2 }

### 4e. Find for a student that does not exist -> 404
GET {{baseUrl}}/find?studentId=999
X-API-KEY: {{alexKey}}


######################################################################
